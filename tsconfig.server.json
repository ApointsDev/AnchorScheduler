{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./server/dist",
    "rootDir": "./server",
    "moduleResolution": "bundler"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "server/dist"]
}