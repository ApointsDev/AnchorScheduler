# 服务器配置
PORT=3000
FRONTEND_URL=http://localhost:5173


# CAF OAuth配置
CAF_SERVER_BASE_URL=
# 留空时默认使用 http://localhost:${PORT}/auth/caf/callback
CAF_REDIRECT_URI=
CAF_SUBSERVER_NAME=AI Time Manager
# CAF 自动注册后凭据持久化文件（默认 server/.caf-client.json）
CAF_CREDENTIALS_FILE=
# CAF RSA 密钥文件（默认 server/.caf-public.pem 和 server/.caf-private.pem）
CAF_PUBLIC_KEY_FILE=
CAF_PRIVATE_KEY_FILE=
# CAF 登录时自动派发的邮箱域名（默认 apoints.email）
CAF_EMAIL_DOMAIN=apoints.email
# CAF 用户自动绑定 SMTP 的服务器配置
CAF_SMTP_HOST=smtp.apoints.email
CAF_SMTP_PORT=587
CAF_SMTP_TLS=true


# JWT配置
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Microsoft认证配置
MS_CLIENT_ID=
MS_AUTHORITY=https://login.microsoftonline.com/common
MS_CLIENT_SECRET=

# 学术配置
ACADEMIC_WEEK_OFFSET=0
ACADEMIC_YEAR_START_MONTH=9
ACADEMIC_YEAR_START_DAY=1

# OpenAI/LLM API配置
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Exchange配置（如果使用）
EXCHANGE_URL=https://mail.xjtlu.edu.cn/EWS/Exchange.asmx
EXCHANGE_DOMAIN=xjtlu.edu.cn
EXCHANGE_CLIENT_ID=
EXCHANGE_CLIENT_SECRET=
EXCHANGE_SCOPE=offline_access https://graph.microsoft.com/Mail.Read https://graph.microsoft.com/Calendars.Read
EXCHANGE_AUTH_MODE=graph

# 管理员邮箱列表（逗号分隔，用于后台管理页面访问控制）
ADMIN_EMAILS=admin@example.com

# 文件日志配置
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
LOG_MAX_FILE_SIZE=10485760
LOG_MAX_FILES=5